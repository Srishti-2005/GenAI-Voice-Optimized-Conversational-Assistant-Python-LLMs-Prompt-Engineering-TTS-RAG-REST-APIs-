# Optional: Configure external LLM and Embedding API keys if you want to use cloud providers.
# If omitted or left blank, the assistant automatically uses the built-in offline engine!
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# MLflow Settings
MLFLOW_EXPERIMENT_NAME=Enterprise-Document-RAG
MLFLOW_TRACKING_URI=sqlite:///data/storage/mlflow.db

# RAG Pipeline Defaults
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=80
DEFAULT_TOP_K=4
DEFAULT_RETRIEVAL_MODE=hybrid
